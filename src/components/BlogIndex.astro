---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import { strings, localePath, type Lang } from '../i18n/strings';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const posts = (await getCollection('blog', (p) => p.id.startsWith(`${lang}/`))).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const date = new Intl.DateTimeFormat(lang, { dateStyle: 'long' });
---

<Site lang={lang} title={`${t.blog.title} · Plot Twist`} description={t.blog.description} altPath={lang === 'en' ? '/hu/blog/' : '/blog/'}>
	<section class="section wrap page-top">
		<h1 class="page-title">{t.blog.title}</h1>
		<ol class="post-list">
			{
				posts.map((post) => (
					<li>
						<time datetime={post.data.date.toISOString().slice(0, 10)}>{date.format(post.data.date)}</time>
						<a href={localePath(lang, `/blog/${post.id.split('/')[1]}/`)}>{post.data.title}</a>
						<p>{post.data.description}</p>
					</li>
				))
			}
		</ol>
	</section>
</Site>
