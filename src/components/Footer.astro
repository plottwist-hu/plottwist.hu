---
import Mark from './Mark.astro';
import { strings, localePath, EMAIL, SOCIAL, type Lang } from '../i18n/strings';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
---

<footer class="site-footer wrap">
	<div class="footer-brand">
		<Mark height={22} />
		<span class="wordmark">Plot Twist</span>
	</div>
	<ul class="footer-links">
		<li><a href={localePath(lang, '/docs/advanced-pixel-for-barion/')}>{t.footer.docs}</a></li>
		<li><a href={localePath(lang, '/blog/')}>{t.nav.blog}</a></li>
		<li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
		{
			SOCIAL.map(({ label, href }) => (
				<li>
					<a href={href}>{label}</a>
				</li>
			))
		}
	</ul>
	<p class="footer-copy">© {new Date().getFullYear()} Plot Twist</p>
</footer>
