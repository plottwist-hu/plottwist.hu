---
import { getCollection } from 'astro:content';
import BlogPost from '../../../components/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', (p) => p.id.startsWith('hu/'));
	return posts.map((post) => ({ params: { slug: post.id.split('/')[1] }, props: { post } }));
}
---

<BlogPost lang="hu" post={Astro.props.post} />
